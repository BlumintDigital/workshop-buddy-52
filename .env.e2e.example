# E2E test configuration — copy to .env.e2e (gitignored) and fill in.
# Supabase URL/key are read from the existing .env automatically.

# The deployed app to test against
E2E_BASE_URL=https://your-app.vercel.app

# Dedicated test accounts. Create them fresh — do NOT enroll 2FA yourself:
# the test setup enrolls TOTP for admin/manager programmatically and stores
# the secret in e2e/.state/ so tests can generate codes.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional — extra roles unlock more of the suite
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
