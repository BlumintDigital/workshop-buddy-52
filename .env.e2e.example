# E2E test configuration — copy to .env.e2e (gitignored) and fill in.
#
# `npm run test:e2e` runs against the local test database (see
# supabase-test/README.md), which creates these accounts itself on
# `npm run test-db:reset`. `npm run test:e2e:prod` runs the read-only checks
# against the live app at E2E_BASE_URL, where the accounts must already exist.

# The deployed app, for the read-only production checks
E2E_BASE_URL=https://your-app.vercel.app

# Dedicated test accounts. On production, create them fresh — do NOT enroll 2FA yourself:
# the test setup enrolls TOTP for admin/manager programmatically and stores
# the secret in e2e/.state/ so tests can generate codes.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional — extra roles unlock more of the suite
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
