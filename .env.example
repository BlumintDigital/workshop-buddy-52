# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Resend — set as a Supabase SECRET (not a Vite env var) per customer:
#   supabase secrets set RESEND_API_KEY=re_xxxx --project-ref <project-ref>
# Each customer needs their own Resend account with a verified sender domain.
# The from address is configured in Settings → Email inside the app.
# RESEND_API_KEY=re_xxxxxxxxxxxxx

# Push Notifications (Web Push / VAPID) — set as a Supabase SECRET per customer:
# 1. Call GET admin-api?action=generate_vapid to generate a key pair.
#    The public key is stored automatically in workshop_settings.
# 2. Set the returned private key as a secret:
#   supabase secrets set VAPID_PRIVATE_KEY=<privateKey> --project-ref <project-ref>
# 3. Redeploy the admin-api function for the secret to take effect.
# VAPID_PRIVATE_KEY=<base64url-encoded-private-key>
