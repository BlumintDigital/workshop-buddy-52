# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Resend — set as a Supabase SECRET (not a Vite env var) per customer:
#   supabase secrets set RESEND_API_KEY=re_xxxx --project-ref <project-ref>
# Each customer needs their own Resend account with a verified sender domain.
# The from address is configured in Settings → Email inside the app.
# RESEND_API_KEY=re_xxxxxxxxxxxxx
